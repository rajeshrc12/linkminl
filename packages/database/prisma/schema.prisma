generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String
  image String?
  urls  Url[]
}

model Url {
  id        Int     @id @default(autoincrement())
  shortCode String  @unique
  original  String
  title     String? @default("Untitled")
  user      User    @relation(fields: [userId], references: [id])
  userId    Int
}
